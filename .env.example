# =============================================================================
# Plantilla de variables de entorno (desarrollo local con docker compose).
# Copiar a .env y completar. .env NUNCA se sube a git.
# Para producción las mismas variables se cargan en Render y Vercel.
# Los valores por defecto viven en config/settings.py, no aquí.
# =============================================================================

# --- Django ------------------------------------------------------------------
SECRET_KEY=cambiar-por-una-clave-secreta-larga
DJANGO_DEBUG=true
USE_HTTPS=false
ALLOWED_HOSTS=localhost,127.0.0.1,backend
FRONTEND_URL=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Base de datos (PostgreSQL) ----------------------------------------------
DB_NAME=nimsutz_db
DB_USER=nimsutz_user
DB_PASSWORD=cambiar-password-db
DB_HOST=db
DB_PORT=5432
DB_SSLMODE=prefer

# --- Almacenamiento de archivos (MinIO en local; R2 o S3 en producción) -------
# Interno: lo usa el backend. Público: va dentro de las URLs firmadas que abre el navegador.
STORAGE_BACKEND_CLASS=files.storage.s3_compatible.S3CompatibleStorageBackend
STORAGE_ENDPOINT_URL=http://minio:9000
STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
STORAGE_BUCKET_NAME=nimsutz-storage
STORAGE_ACCESS_KEY=nimsutz_admin
STORAGE_SECRET_KEY=cambiar-password-storage
STORAGE_REGION=us-east-1
# Usuario raíz del contenedor MinIO (solo desarrollo local).
MINIO_ROOT_USER=nimsutz_admin
MINIO_ROOT_PASSWORD=cambiar-password-storage

# --- Subidas y cuota ----------------------------------------------------------
RESERVATION_TTL_MINUTES=10
PAID_PLANS_ENABLED=false

# --- Correo -------------------------------------------------------------------
# Si EMAIL_HOST queda vacío, los correos salen en la consola del backend.
# Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=true,
# EMAIL_HOST_USER=<tu-cuenta>@gmail.com, EMAIL_HOST_PASSWORD=<contraseña de aplicación>
# DEFAULT_FROM_EMAIL debe ser la misma cuenta.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@nimsutz.local
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440

# --- Pagos simulados ----------------------------------------------------------
# Clave de al menos 32 caracteres, distinta de SECRET_KEY.
PAYMENTS_IDEMPOTENCY_SECRET=

# --- Frontend (Vite) ----------------------------------------------------------
# Son públicas: nunca poner secretos en variables VITE_*.
VITE_API_URL=http://localhost:8000

# --- Tareas periódicas --------------------------------------------------------
CRON_TOKEN=pega-aqui-el-valor-generado