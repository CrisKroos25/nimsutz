# Django
SECRET_KEY=cambiar-por-una-clave-secreta

# PostgreSQL
DB_NAME=nimsutz_db
DB_USER=nimsutz_user
DB_PASSWORD=nimsutz_pass
DB_HOST=db
DB_PORT=5432

# MinIO
MINIO_ROOT_USER=nimsutz_admin
MINIO_ROOT_PASSWORD=nimsutz_admin_pass
MINIO_ENDPOINT=http://minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=nimsutz_admin
MINIO_SECRET_KEY=nimsutz_admin_pass
MINIO_BUCKET_NAME=nimsutz-storage

STORAGE_BACKEND_CLASS=files.storage.s3_compatible.S3CompatibleStorageBackend

# Frontend
VITE_API_URL=http://localhost:8000
# Vite local: destino del proxy /api. Compose fija http://backend:8000.
# Para cambiarlo fuera de Docker, definir API_PROXY_TARGET en el entorno
# del proceso que ejecuta npm run dev (por defecto http://127.0.0.1:8000).

# Servicio de correo
DEFAULT_FROM_EMAIL=no-reply@nimsutz.local
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_TTL_MINUTES=30
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=1440
# SMTP real (opcional). Si EMAIL_HOST queda vacio, los correos salen en la consola del backend.
# Ejemplo Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=true,
# EMAIL_HOST_USER=<cuenta>@gmail.com, EMAIL_HOST_PASSWORD=<contrasena de aplicacion>,
# y DEFAULT_FROM_EMAIL=<la misma cuenta>. Nunca subir estos valores al repositorio.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_HOST_USER=nimsutzcloud@gmail.com
EMAIL_HOST_PASSWORD=<contrasena-de-aplicacion>
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=nimsutzcloud@gmail.com